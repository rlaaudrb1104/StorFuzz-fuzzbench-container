diff --git a/fuzzers/angora/0001-Ignore-STACKMAP-instruction-in-x87-stackifier.patch b/fuzzers/angora/0001-Ignore-STACKMAP-instruction-in-x87-stackifier.patch
new file mode 100644
index 0000000..12bd51b
